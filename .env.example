# Копирай на .env и попълни реалните ключове. НИКОГА не commit-вай .env в git.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Callflow / Omnilinx PBX API (получава се от клиента след платен достъп)
CALLFLOW_HOST=https://uhub.callflowlab.com
CALLFLOW_USERNAME=
CALLFLOW_PASSWORD=
CALLFLOW_CODE=
CALLFLOW_CLIENTID=

# Dashboard достъп (1 общ логин)
DASHBOARD_PASSWORD=changeme
DASHBOARD_SECRET_KEY=generate-a-random-string-here
